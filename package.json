{
    "name": "marketplace",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.13.0 <23"
    },
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prestart": "npm run build",
        "start": "node server.js",
        "predev": "npm run build",
        "dev": "nodemon server.js",
        "pretest": "npm run build",
        "test": "node scripts/run-tests.js",
        "pretest:coverage": "npm run build",
        "test:coverage": "node scripts/run-tests.js --coverage",
        "pretest:watch": "npm run build",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "npm run build && husky"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cloudinary": "2.11.0",
        "cookie-parser": "~1.4.7",
        "cors": "^2.8.4",
        "debug": "~2.6.9",
        "dotenv": "^10.0.0",
        "enigma-code": "0.0.11",
        "express": "5.2.1",
        "gridfs-stream": "^1.1.1",
        "http-errors": "~1.6.2",
        "jsonwebtoken": "^8.4.0",
        "jwt-simple": "^0.5.6",
        "moment": "^2.31.0",
        "mongoose": "8.24.1",
        "morgan": "^1.12.1",
        "multer": "2.4.0",
        "node-mailjet": "6.0.11",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "socket.io": "4.8.4",
        "twilio": "6.1.1"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/eslint-parser": "7.29.7",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.1",
        "@vitest/coverage-v8": "^1.6.1",
        "c8": "^10.1.3",
        "eslint": "9.39.5",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "mongodb-memory-server": "^10.1.4",
        "nodemon": "^1.19.1",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.6",
        "supertest": "^7.1.1",
        "typescript": "^7.0.2",
        "vitest": "^1.6.1"
    },
    "lint-staged": {
        "*.{js,cjs,mjs}": [
            "eslint --fix",
            "prettier --write --ignore-path .gitignore"
        ],
        "*.ts": "prettier --write --ignore-path .gitignore",
        "*.{json,jsonc,md,yml,yaml}": "prettier --write --ignore-path .gitignore"
    }
}
