{
    "name": "marketplace",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.13.0 <23"
    },
    "private": true,
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.14.0",
        "cookie-parser": "~1.4.3",
        "cors": "^2.8.4",
        "debug": "~2.6.9",
        "dotenv": "^10.0.0",
        "enigma-code": "0.0.11",
        "express": "5.2.1",
        "gridfs-stream": "^1.1.1",
        "http-errors": "~1.6.2",
        "jsonwebtoken": "^8.4.0",
        "jwt-simple": "^0.5.5",
        "moment": "^2.22.2",
        "mongoose": "6.13.10",
        "morgan": "^1.9.1",
        "multer": "2.2.0",
        "node-mailjet": "^3.3.1",
        "nodemailer": "^6.4.10",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "socket.io": "^2.1.1",
        "twilio": "^3.23.1"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^1.6.1",
        "eslint": "9.39.5",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "mongodb-memory-server": "^10.1.4",
        "nodemon": "^1.19.1",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.6",
        "supertest": "^7.1.1",
        "vitest": "^1.6.1"
    },
    "lint-staged": {
        "*.{js,cjs,mjs}": [
            "eslint --fix",
            "prettier --write --ignore-path .gitignore"
        ],
        "*.{json,jsonc,md,yml,yaml}": "prettier --write --ignore-path .gitignore"
    }
}
